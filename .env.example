# Required: your OpenAI API key (needs GPT-5 access).
# Not needed if you're running fully local via Ollama (see below).
OPENAI_API_KEY=your-api-key-here

# Contact info sent to SEC EDGAR in the User-Agent. SEC asks you to identify yourself.
# Example: "Jane Doe <jane@example.com>"
# EDGAR_USER_AGENT=your-name <you@example.com>

# REPL sandbox for RLM code execution.
# "docker" (default, safe) runs untrusted code in a sandboxed container.
# "local" runs it in-process: faster, but only use with trusted inputs.
# RLM_ENVIRONMENT=docker

# Bounded worker pool for RLM completions. Default 3. Tune based on RAM:
#   8 GB → 2, 16 GB → 3-4, 32 GB+ → 5-8
# RLM_MAX_WORKERS=3

# Local Ollama configuration (optional, replaces OpenAI for fully offline use).
# 1. ollama serve
# 2. ollama pull qwen3:8b && ollama pull qwen3:4b
# 3. Uncomment the three lines below, then run secdd with `--local`.
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# LOCAL_ROOT_MODEL_NAME=qwen3:8b
# LOCAL_SUB_MODEL_NAME=qwen3:4b
